# Semi Senti — Next.js 환경 변수 템플릿
# .env.local 로 복사 후 사용하세요.

# Python FastAPI 백엔드 URL
NEXT_PUBLIC_API_BASE_URL=http://localhost:8001

# 자동 갱신 주기 (초, F-4.2.4)
NEXT_PUBLIC_AUTO_REFRESH_SECONDS=60

# 뉴스 탭 활성화 여부. "false" 로 두면 뉴스 API 미구동 시 뉴스 탭을 숨긴다.
# 미설정(기본) 시 활성화 상태로 동작한다.
NEXT_PUBLIC_NEWS_API_READY=true
